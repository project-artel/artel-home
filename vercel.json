{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "rewrites": [
    {
      "source": "/console",
      "destination": "/console/index.html"
    },
    {
      "source": "/console/:path*",
      "destination": "/console/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
